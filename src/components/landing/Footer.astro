---
import { execSync } from 'child_process';
import { readFileSync } from 'node:fs';

const pkg = JSON.parse(readFileSync('./package.json', 'utf-8'));
let commitHash = 'dev';
try {
  commitHash = execSync('git rev-parse --short HEAD', { encoding: 'utf-8' }).toString().trim();
} catch {}
---
<style>
  footer#viewport-footer { background-color: #EBEBDF !important; border-color: #D6D6C8 !important; color: #252422; }
  footer#viewport-footer a, footer#viewport-footer p, footer#viewport-footer span { color: #5A5957; }
  footer#viewport-footer a:hover { color: #EB1D62; }
  footer#viewport-footer .sep { color: #D6D6C8; }
  footer#viewport-footer .bold { color: #252422; font-weight: 600; }
</style>
<footer id="viewport-footer" class="py-16 px-6 border-t mt-auto relative">
  <div class="max-w-2xl mx-auto flex flex-col items-center text-center gap-5">
    <a href="/" class="flex items-center">
      <img src="/img/logo.png" alt="ViewPort" class="h-7 opacity-90 hover:opacity-100 transition-opacity" />
    </a>
    <p class="text-sm leading-relaxed" style="max-width: 280px;">
      An open-source web toolkit for developers.
    </p>
    <div class="flex items-center gap-3 text-xs">
      <span class="sep">/</span>
      <a href="https://github.com/Wingky530/viewport" target="_blank" rel="noopener noreferrer">GitHub</a>
      <span class="sep">/</span>
    </div>
    <div class="flex flex-col items-center gap-1 pt-4">
      <p class="text-xs leading-relaxed">
        Built with <span class="bold">Astro</span>, <span class="bold">React</span>, <span class="bold">TypeScript</span>, and <span class="bold">Tailwind CSS</span>
      </p>
      <span class="text-[10px] font-mono">
        v{pkg.version} &middot; {commitHash}
      </span>
    </div>
  </div>
</footer>

<section id="features" class="border-t border-border" style="background-color: var(--color-surface)">
  <div class="max-w-7xl mx-auto px-6 py-20 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-text">Everything you need</h2>
    <p class="mt-4 text-text-muted">No account required. No limits. Completely free.</p>
    <div class="mt-14 grid sm:grid-cols-3 gap-8">
      <div class="p-8 rounded-2xl bg-bg border border-border text-left hover:border-accent/30 transition-colors group">
        <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-5 group-hover:bg-accent/20 transition-colors">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
            <rect width="14" height="20" x="5" y="2" rx="2" ry="2" /><path d="M12 18h.01" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-text mb-2">100+ Devices</h3>
        <p class="text-sm text-text-muted leading-relaxed">
          Test on iPhones, Samsungs, Pixels, iPads, and more. Every device you need, ready to go.
        </p>
      </div>
      <div class="p-8 rounded-2xl bg-bg border border-border text-left hover:border-accent/30 transition-colors group">
        <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-5 group-hover:bg-accent/20 transition-colors">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
            <rect width="7" height="18" x="3" y="3" rx="1" /><rect width="7" height="18" x="14" y="3" rx="1" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-text mb-2">Multi-View</h3>
        <p class="text-sm text-text-muted leading-relaxed">
          Compare mobile, tablet, and desktop views side-by-side. See how your site adapts.
        </p>
      </div>
      <div class="p-8 rounded-2xl bg-bg border border-border text-left hover:border-accent/30 transition-colors group">
        <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-5 group-hover:bg-accent/20 transition-colors">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-text mb-2">Share Links</h3>
        <p class="text-sm text-text-muted leading-relaxed">
          Bookmark and share your exact test configurations. Collaborate with your team effortlessly.
        </p>
      </div>
    </div>
  </div>
</section>

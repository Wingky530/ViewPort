import { useEffect, useRef } from 'react';
import * as THREE from 'three';

function createToonGradient(): THREE.Texture {
  const c = document.createElement('canvas');
  c.width = 1;
  c.height = 3;
  const ctx = c.getContext('2d')!;
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0, 0, 1, 1);
  ctx.fillStyle = '#cccccc';
  ctx.fillRect(0, 1, 1, 1);
  ctx.fillStyle = '#666666';
  ctx.fillRect(0, 2, 1, 1);
  const tex = new THREE.CanvasTexture(c);
  tex.magFilter = THREE.NearestFilter;
  tex.minFilter = THREE.NearestFilter;
  return tex;
}

function createScreenCanvas(): HTMLCanvasElement {
  const c = document.createElement('canvas');
  c.width = 2048;
  c.height = 1280;
  const ctx = c.getContext('2d')!;

  ctx.fillStyle = '#000523';
  ctx.fillRect(0, 0, 2048, 1280);

  ctx.fillStyle = '#A0A3B5';
  ctx.font = 'bold 44px monospace';
  ctx.textAlign = 'left';
  ctx.fillText('ViewPort', 100, 110);

  const cx = 1024, cy = 620;
  ctx.fillStyle = 'rgba(19, 25, 83, 0.5)';
  roundRect(ctx, cx - 520, cy - 240, 1040, 480, 32);
  ctx.fill();

  ctx.fillStyle = '#F1EFF5';
  ctx.font = 'bold 84px sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('Discover', cx, cy - 80);

  ctx.fillStyle = '#A0A3B5';
  ctx.font = '36px sans-serif';
  ctx.fillText('Preview and test your website', cx, cy + 20);

  ctx.fillStyle = 'rgba(107,111,133,0.4)';
  roundRect(ctx, cx - 280, cy + 80, 560, 12, 6);
  ctx.fill();
  ctx.fillStyle = 'rgba(107,111,133,0.3)';
  roundRect(ctx, cx - 200, cy + 112, 400, 10, 5);
  ctx.fill();
  ctx.fillStyle = 'rgba(107,111,133,0.2)';
  roundRect(ctx, cx - 120, cy + 144, 240, 8, 4);
  ctx.fill();

  ctx.fillStyle = '#EB1D62';
  ctx.font = '32px sans-serif';
  ctx.fillText('Learn More', cx, cy + 300);

  ctx.fillStyle = '#EB1D62';
  ctx.beginPath();
  ctx.moveTo(cx - 12, cy + 324);
  ctx.lineTo(cx + 12, cy + 324);
  ctx.lineTo(cx, cy + 340);
  ctx.closePath();
  ctx.fill();

  return c;
}

function createLogoSprite(): HTMLCanvasElement {
  const c = document.createElement('canvas');
  c.width = 120;
  c.height = 120;
  const ctx = c.getContext('2d')!;

  ctx.clearRect(0, 0, 120, 120);

  const cx = 60, cy = 60;
  ctx.strokeStyle = '#EB1D62';
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.moveTo(cx, cy - 30);
  ctx.lineTo(cx + 24, cy);
  ctx.lineTo(cx, cy + 30);
  ctx.lineTo(cx - 24, cy);
  ctx.closePath();
  ctx.stroke();

  ctx.fillStyle = '#EB1D62';
  ctx.beginPath();
  ctx.moveTo(cx, cy - 14);
  ctx.lineTo(cx + 11, cy);
  ctx.lineTo(cx, cy + 14);
  ctx.lineTo(cx - 11, cy);
  ctx.closePath();
  ctx.fill();

  return c;
}

function roundRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

export default function Laptop3D({ progress }: { progress: number }) {
  const containerRef = useRef<HTMLDivElement>(null);
  const cameraRef = useRef<THREE.PerspectiveCamera | null>(null);
  const lidGroupRef = useRef<THREE.Group | null>(null);
  const screenGroupRef = useRef<THREE.Group | null>(null);
  const macGroupRef = useRef<THREE.Group | null>(null);
  const logoMatRef = useRef<THREE.MeshBasicMaterial | null>(null);
  const fadeGroupRef = useRef<THREE.Group | null>(null);
  const screenMatRef = useRef<THREE.MeshBasicMaterial | null>(null);

  useEffect(() => {
    const container = containerRef.current;
    if (!container) return;

    const w = container.clientWidth;
    const h = container.clientHeight;

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(42, w / h, 0.1, 200);
    camera.position.set(0, 2, 55);
    camera.lookAt(0, 0, 0);
    cameraRef.current = camera;

    const canvasEl = document.createElement('canvas');
    canvasEl.style.cssText = 'width:100%;height:100%;display:block';
    container.appendChild(canvasEl);

    const renderer = new THREE.WebGLRenderer({ canvas: canvasEl, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(w, h);
    renderer.setClearColor(0x000000, 0);

    const ambient = new THREE.AmbientLight(0xffffff, 0.7);
    scene.add(ambient);

    const key = new THREE.DirectionalLight(0xffffff, 2.0);
    key.position.set(15, 25, 30);
    scene.add(key);

    const fill = new THREE.DirectionalLight(0x8888ff, 0.6);
    fill.position.set(-20, 15, -15);
    scene.add(fill);

    const rim = new THREE.DirectionalLight(0x4466ff, 0.4);
    rim.position.set(0, -10, -35);
    scene.add(rim);

    const toonTex = createToonGradient();

    const lidMat = new THREE.MeshToonMaterial({ color: 0x131953, gradientMap: toonTex });
    const bezelMat = new THREE.MeshToonMaterial({ color: 0x080808, gradientMap: toonTex });
    const baseMat = new THREE.MeshToonMaterial({ color: 0x131953, gradientMap: toonTex });
    const deckMat = new THREE.MeshToonMaterial({ color: 0x0D1150, gradientMap: toonTex });
    const keyMat = new THREE.MeshToonMaterial({ color: 0x222244, gradientMap: toonTex });
    const tpMat = new THREE.MeshToonMaterial({ color: 0x1a1a3a, gradientMap: toonTex });

    const edgeMat = new THREE.LineBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.25 });

    const macGroup = new THREE.Group();
    macGroup.scale.setScalar(0.7);
    scene.add(macGroup);
    macGroupRef.current = macGroup;

    const fadeGroup = new THREE.Group();
    macGroup.add(fadeGroup);
    fadeGroupRef.current = fadeGroup;

    const lidGroup = new THREE.Group();
    fadeGroup.add(lidGroup);
    lidGroupRef.current = lidGroup;

    // === LID SHELL ===
    const lidGeom = new THREE.BoxGeometry(30, 19, 0.8);
    lidGeom.translate(0, 9.5, 0);
    const lidMesh = new THREE.Mesh(lidGeom, lidMat);
    lidGroup.add(lidMesh);
    const lidEdgeGeom = new THREE.EdgesGeometry(lidGeom);
    const lidEdgeLine = new THREE.LineSegments(lidEdgeGeom, edgeMat);
    lidGroup.add(lidEdgeLine);

    // === LOGO (outer face) ===
    const logoCanvas = createLogoSprite();
    const logoTex = new THREE.CanvasTexture(logoCanvas);
    logoTex.needsUpdate = true;
    const logoMat = new THREE.MeshBasicMaterial({ map: logoTex, transparent: true, depthWrite: false, opacity: 0 });
    logoMatRef.current = logoMat;
    const logoGeom = new THREE.PlaneGeometry(2.5, 2.5);
    logoGeom.translate(0, 9.5, 0.41);
    const logoMesh = new THREE.Mesh(logoGeom, logoMat);
    lidGroup.add(logoMesh);

    // === SCREEN (separate from lidGroup, always faces viewer) ===
    const screenGroup = new THREE.Group();
    screenGroup.position.set(0, 9.5, 2);
    macGroup.add(screenGroup);
    screenGroupRef.current = screenGroup;

    const screenCanvas = createScreenCanvas();
    const screenTex = new THREE.CanvasTexture(screenCanvas);
    screenTex.needsUpdate = true;
    const screenMat = new THREE.MeshBasicMaterial({
      map: screenTex,
      transparent: true,
      opacity: 0,
      depthWrite: false,
    });
    screenMatRef.current = screenMat;
    const screenGeom = new THREE.PlaneGeometry(25, 16);
    const screenMesh = new THREE.Mesh(screenGeom, screenMat);
    screenGroup.add(screenMesh);

    // === BEZEL ===
    const bezelGeom = new THREE.BoxGeometry(27, 17.2, 0.06);
    bezelGeom.translate(0, 9.5, -0.45);
    const bezelMesh = new THREE.Mesh(bezelGeom, bezelMat);
    lidGroup.add(bezelMesh);
    const bezelEdgeGeom = new THREE.EdgesGeometry(bezelGeom);
    const bezelEdgeLine = new THREE.LineSegments(bezelEdgeGeom, edgeMat);
    lidGroup.add(bezelEdgeLine);

    // === BASE ===
    const baseGeom = new THREE.BoxGeometry(30, 1.0, 20);
    baseGeom.translate(0, -0.5, -10);
    const baseMesh = new THREE.Mesh(baseGeom, baseMat);
    fadeGroup.add(baseMesh);
    const baseEdgeGeom = new THREE.EdgesGeometry(baseGeom);
    const baseEdgeLine = new THREE.LineSegments(baseEdgeGeom, edgeMat);
    fadeGroup.add(baseEdgeLine);

    // === DECK ===
    const deckGeom = new THREE.PlaneGeometry(27, 18);
    deckGeom.translate(0, 0, -10);
    const deckMesh = new THREE.Mesh(deckGeom, deckMat);
    deckMesh.rotation.x = -Math.PI / 2;
    fadeGroup.add(deckMesh);

    // === KEYBOARD ===
    for (let row = 0; row < 4; row++) {
      const keys = row === 0 ? 8 : row === 1 ? 9 : row === 2 ? 9 : 6;
      const rowW = keys * 1.8;
      const startX = -(rowW - 1.8) / 2;
      for (let k = 0; k < keys; k++) {
        const keyGeom = new THREE.BoxGeometry(1.5, 0.08, 0.35);
        keyGeom.translate(startX + k * 1.8, 0.06, -11.5 - row * 1.1);
        const keyMesh = new THREE.Mesh(keyGeom, keyMat);
        fadeGroup.add(keyMesh);
      }
    }

    // === TOUCHPAD ===
    const tpGeom = new THREE.BoxGeometry(4.5, 0.04, 2.8);
    tpGeom.translate(0, 0.06, -16);
    const tpMesh = new THREE.Mesh(tpGeom, tpMat);
    fadeGroup.add(tpMesh);

    let animId: number;
    const tick = () => {
      animId = requestAnimationFrame(tick);
      renderer.render(scene, camera);
    };
    tick();

    const ro = new ResizeObserver((entries) => {
      const { width, height } = entries[0].contentRect;
      if (width === 0 || height === 0) return;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    });
    ro.observe(container);

    return () => {
      cancelAnimationFrame(animId);
      ro.disconnect();
      scene.traverse((obj) => {
        if (obj instanceof THREE.Mesh) {
          obj.geometry.dispose();
          if (obj.material instanceof THREE.Material) obj.material.dispose();
        }
        if (obj instanceof THREE.LineSegments) {
          obj.geometry.dispose();
          if (obj.material instanceof THREE.Material) obj.material.dispose();
        }
      });
      renderer.dispose();
      if (container.contains(canvasEl)) container.removeChild(canvasEl);
    };
  }, []);

  useEffect(() => {
    const lidGroup = lidGroupRef.current;
    const macGroup = macGroupRef.current;
    const camera = cameraRef.current;
    const screenGroup = screenGroupRef.current;
    const logoMat = logoMatRef.current;
    const fadeGroup = fadeGroupRef.current;
    const screenMat = screenMatRef.current;
    if (!lidGroup || !macGroup || !camera || !screenGroup || !logoMat || !fadeGroup || !screenMat) return;

    const easeOutBack = (t: number): number => {
      const c1 = 1.70158;
      const c3 = c1 + 1;
      return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
    };
    const easeInOutCubic = (t: number): number =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

    // Phase 1: Logo fade in (0.00 - 0.08)
    const logoIn = Math.max(0, Math.min(1, (progress - 0.0) / 0.08));
    logoMat.opacity = easeInOutCubic(logoIn);

    // Phase 2: Lid rotation (0.10 - 0.35)
    const lidRaw = Math.max(0, Math.min(1, (progress - 0.10) / 0.25));
    const lidEased = easeOutBack(lidRaw);
    const lidAngle = lidEased * 1.85;
    lidGroup.rotation.x = lidAngle;

    // Logo fades out as lid opens (0.10 - 0.22)
    const logoOut = Math.max(0, Math.min(1, (progress - 0.10) / 0.12));
    logoMat.opacity = Math.max(0, logoIn * (1 - logoOut));

    // Screen fades in +X when pressing the lid opens (0.10 - 0.35)
    const screenAppear = Math.max(0, Math.min(1, (progress - 0.10) / 0.25));
    screenMat.opacity = easeInOutCubic(screenAppear);

    // Phase 3: Camera zoom (0.35 - 0.55)
    const zoomRaw = Math.max(0, Math.min(1, (progress - 0.35) / 0.20));
    const zoomEased = easeInOutCubic(zoomRaw);
    camera.position.z = 55 - zoomEased * 32;
    camera.position.y = 2 + zoomEased * 3;

    macGroup.rotation.x = 0.1 + progress * 0.18;
    macGroup.rotation.y = -0.15 + progress * 0.12;

    // Phase 4: Screen scale up + fade out shell (0.55 - 0.75)
    const transRaw = Math.max(0, Math.min(1, (progress - 0.55) / 0.20));
    const transEased = easeInOutCubic(transRaw);
    const screenScale = 1 + transEased * 2.5;
    screenGroup.scale.set(screenScale, screenScale, 1);
    screenGroup.position.z = 2 + transEased * 2;

    // Fade out all fadeGroup meshes (lid shell, bezel, base, etc.)
    fadeGroup.traverse((child) => {
      if (child instanceof THREE.Mesh) {
        child.material.transparent = true;
        child.material.opacity = 1 - transEased;
      }
      if (child instanceof THREE.LineSegments) {
        (child.material as THREE.Material).transparent = true;
        (child.material as THREE.Material).opacity = 0.25 * (1 - transEased);
      }
    });

    // Phase 5: Final push to full screen (0.75 - 1.00)
    const finalRaw = Math.max(0, Math.min(1, (progress - 0.75) / 0.25));
    const finalEased = easeInOutCubic(finalRaw);
    camera.position.z = 23 - finalEased * 8;
    camera.position.y = 5 + finalEased * 3;

    const screenScale2 = 3.5 + finalEased * 2.5;
    screenGroup.scale.set(screenScale2, screenScale2, 1);
    screenGroup.position.z = 4 + finalEased * 2;
  }, [progress]);

  return (
    <div
      ref={containerRef}
      className="absolute inset-0 overflow-hidden"
      style={{ zIndex: 1, pointerEvents: 'none' }}
    />
  );
}

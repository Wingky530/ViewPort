import { useEffect, useRef, useState } from 'react';

const CYCLE = 10000;
const HALF = CYCLE / 2;

const PA = 600;
const PG = 200;
const PD = 1500;
const PR = 300;
const PF = 400;
const PP = 2000;

const W_MIN = 170;
const W_MAX = 340;
const HO_MAX = 120;

function easeInOutCubic(t: number): number {
  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
}

function HandOpen() {
  return (
    <svg width="22" height="22" viewBox="0 0 256 256" fill="#EBEBDF">
      <path d="M224,104v50.93c0,46.2-36.85,84.55-83,85.06A83.71,83.71,0,0,1,80.6,215.4C58.79,192.33,34.15,136,34.15,136a16,16,0,0,1,6.53-22.23c7.66-4,17.1-.84,21.4,6.62l21,36.44a6.09,6.09,0,0,0,6,3.09l.12,0A8.19,8.19,0,0,0,96,151.74V32a16,16,0,0,1,16.77-16c8.61.4,15.23,7.82,15.23,16.43V104a8,8,0,0,0,8.53,8,8.17,8.17,0,0,0,7.47-8.25V88a16,16,0,0,1,16.77-16c8.61.4,15.23,7.82,15.23,16.43V112a8,8,0,0,0,8.53,8,8.17,8.17,0,0,0,7.47-8.25v-7.28c0-8.61,6.62-16,15.23-16.43A16,16,0,0,1,224,104Z" />
    </svg>
  );
}

function HandGrabIcon() {
  return (
    <svg width="22" height="22" viewBox="0 0 256 256" fill="#EBEBDF">
      <path d="M216,104v48a88,88,0,0,1-176,0V136a16,16,0,0,1,32,0v8a8,8,0,0,0,16,0V88a16,16,0,0,1,32,0v16a8,8,0,0,0,16,0V88a16,16,0,0,1,32,0v16a8,8,0,0,0,16,0,16,16,0,0,1,32,0Z" />
    </svg>
  );
}

interface AnimState {
  width: number;
  handOffset: number;
  handClosed: boolean;
}

export default function HeroAnimation() {
  const [state, setState] = useState<AnimState>({
    width: W_MAX,
    handOffset: HO_MAX,
    handClosed: false,
  });

  const startRef = useRef(0);
  const rafRef = useRef(0);

  useEffect(() => {
    const tick = (ts: number) => {
      if (!startRef.current) startRef.current = ts;
      const elapsed = (ts - startRef.current) % CYCLE;
      const shrink = elapsed >= HALF;
      const t = (elapsed % HALF) / HALF;

      const a = PA / HALF;
      const g = PG / HALF;
      const d = PD / HALF;
      const r = PR / HALF;
      const f = PF / HALF;

      let handOffset = HO_MAX;
      let handClosed = false;
      let width = shrink ? W_MAX : W_MIN;

      if (t < a) {
        const p = t / a;
        width = shrink ? W_MAX : W_MIN;
        handOffset = HO_MAX * (1 - easeInOutCubic(p));
      } else if (t < a + g) {
        const p = (t - a) / g;
        width = shrink ? W_MAX : W_MIN;
        handOffset = 0;
        handClosed = p >= 0.5;
      } else if (t < a + g + d) {
        const p = (t - a - g) / d;
        const ease = easeInOutCubic(p);
        handOffset = 0;
        handClosed = true;
        width = shrink
          ? W_MAX - (W_MAX - W_MIN) * ease
          : W_MIN + (W_MAX - W_MIN) * ease;
      } else if (t < a + g + d + r) {
        const p = (t - a - g - d) / r;
        width = shrink ? W_MIN : W_MAX;
        handOffset = 0;
        handClosed = p < 0.5;
      } else if (t < a + g + d + r + f) {
        const p = (t - a - g - d - r) / f;
        width = shrink ? W_MIN : W_MAX;
        handOffset = HO_MAX * easeInOutCubic(p);
      } else {
        width = shrink ? W_MIN : W_MAX;
        handOffset = HO_MAX;
        handClosed = false;
      }

      setState({ width, handOffset, handClosed });
      rafRef.current = requestAnimationFrame(tick);
    };

    rafRef.current = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(rafRef.current);
  }, []);

  const { width, handOffset, handClosed } = state;
  const isNarrow = width < 220;

  return (
    <div className="mt-16 w-full max-w-[360px] mx-auto relative overflow-visible" style={{ height: 390 }}>
      <div
        className="absolute top-0 left-1/2 -translate-x-1/2 bg-surface border border-border rounded-xl overflow-hidden shadow-2xl"
        style={{ width: `${width}px`, maxWidth: '100%' }}
      >
        <div className={`h-9 bg-surface border-b border-border flex items-center px-4 gap-2 ${!isNarrow ? '' : 'justify-center'}`}>
          {!isNarrow && (
            <div className="flex gap-1.5">
              <div className="w-3 h-3 rounded-full bg-danger/60" />
              <div className="w-3 h-3 rounded-full bg-warning/60" />
              <div className="w-3 h-3 rounded-full bg-success/60" />
            </div>
          )}
          <div className="h-5 bg-bg/50 rounded flex items-center px-2" style={{ width: isNarrow ? '100%' : 'flex-1' }}>
            <span className="text-[10px] text-text-dim font-mono truncate w-full text-center">localhost:4321</span>
          </div>
        </div>

        <div className="bg-bg p-6" style={{ minHeight: isNarrow ? 240 : 280 }}>
          <div className="flex gap-4 mb-6">
            <div className="h-3 w-16 rounded bg-text-dim/15" />
            <div className="h-3 w-14 rounded bg-text-dim/15" />
            <div className="h-3 w-12 rounded bg-text-dim/15" />
          </div>

          <div className="flex gap-4" style={{ flexDirection: width < 240 ? 'column' : 'row' }}>
            {width >= 240 && (
              <div className="space-y-3 w-1/4 min-w-[60px]">
                <div className="h-24 rounded-lg bg-text-dim/10" />
                <div className="h-3 w-3/4 rounded bg-text-dim/15" />
                <div className="h-3 w-1/2 rounded bg-text-dim/15" />
              </div>
            )}
            <div className="flex-1 space-y-4">
              <div className="h-5 w-3/5 rounded bg-text-dim/20" />
              <div className="h-3 w-full rounded bg-text-dim/10" />
              <div className="h-3 w-11/12 rounded bg-text-dim/10" />
              <div className="h-3 w-4/5 rounded bg-text-dim/10" />
              <div className={`grid gap-3 mt-6 ${isNarrow ? 'grid-cols-2' : 'grid-cols-3'}`}>
                <div className="h-20 rounded-lg bg-text-dim/10" />
                <div className="h-20 rounded-lg bg-text-dim/10" />
                {!isNarrow && (
                  <div className="h-20 rounded-lg bg-text-dim/10" />
                )}
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        className="absolute top-[40%] z-30 pointer-events-none"
        style={{
          left: `calc(50% + ${width / 2}px + ${handOffset}px)`,
          transform: 'translateY(-50%)',
          marginLeft: handOffset === 0 ? '-3px' : '0',
        }}
      >
        <div className="w-9 h-9 rounded-full bg-accent/20 flex items-center justify-center">
          {handClosed ? <HandGrabIcon /> : <HandOpen />}
        </div>
      </div>
    </div>
  );
}

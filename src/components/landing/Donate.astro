        href="https://ko-fi.com/wingky530"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-center gap-3 px-6 py-4 w-full sm:w-auto text-base font-semibold text-text border border-border hover:border-[#13C3FF] hover:text-[#13C3FF] hover:bg-[#13C3FF]/10 rounded-lg transition-all"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="transition-colors">
          <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.051-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.74 4.311zm8.173.878c-1.008 1.517-2.794 1.637-2.794 1.637l-.029-4.992s1.452-.027 2.46-.027c1.006 0 1.797 1.204 1.269 2.616-.078.146-.421.432-.906.766z" />
        </svg>
        Support on Ko-fi
      </a>

      <!-- Trakteer -->
      <a
        href="https://trakteer.id/wingky530"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-center gap-3 px-6 py-4 w-full sm:w-auto text-base font-semibold text-text border border-border hover:border-[#BE1E2D] hover:text-[#BE1E2D] hover:bg-[#BE1E2D]/10 rounded-lg transition-all"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-colors group-hover:fill-[#BE1E2D]/20">

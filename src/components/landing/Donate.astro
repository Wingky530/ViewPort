<section id="donate" data-section>
  <div class="max-w-5xl mx-auto px-6 py-24 text-center">
    <h2 class="text-3xl font-bold text-text mb-4">Fuel the <span class="text-accent">Development</span></h2>
    <p class="text-text-muted text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
      ViewPort is 100% free and open-source. If this tool saves you time, consider buying me a coffee or sponsoring the project to keep the updates coming.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      
      <!-- GitHub Sponsors -->
      <a
        href="https://github.com/sponsors/Wingky530"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-center gap-3 px-6 py-4 w-full sm:w-auto text-base font-semibold text-text border border-border hover:border-[#ea4aaa] hover:text-[#ea4aaa] hover:bg-[#ea4aaa]/10 rounded-lg transition-all"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-colors group-hover:fill-[#ea4aaa]/20">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
        </svg>
        Sponsor on GitHub

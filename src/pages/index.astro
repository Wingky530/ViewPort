---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <!-- Navbar -->
  <nav class="flex items-center justify-between px-6 py-4 border-b border-border max-w-7xl mx-auto">
    <div class="flex items-center gap-8">
      <span class="text-xl font-bold text-accent">ViewPort</span>
      <div class="hidden sm:flex items-center gap-6">
        <span class="text-sm text-text font-medium">Home</span>
        <a href="/app" class="text-sm text-text-muted hover:text-text transition-colors">App</a>
      </div>
    </div>
    <a
      href="#"
      class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-danger rounded-lg hover:bg-red-500 transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
      </svg>
      Donate
    </a>
  </nav>

  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-20 pb-24 text-center">
    <h1 class="text-5xl sm:text-6xl font-bold leading-tight text-text">
      Test your responsive designs<br />
      <span class="text-accent">instantly</span>
    </h1>
    <p class="mt-6 text-lg text-text-muted max-w-2xl mx-auto">
      Preview any website on 100+ real devices without leaving your browser.
      No account required. No limits. Completely free.
    </p>
    <div class="mt-10">
      <a
        href="/app"
        class="inline-flex items-center gap-2 px-8 py-4 text-lg font-semibold text-white bg-accent rounded-xl hover:bg-accent-hover transition-colors shadow-lg shadow-accent/20"
      >
        Try ViewPort Free
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Device mockups -->
    <div class="mt-20 flex items-end justify-center gap-4 sm:gap-6">
      <!-- Phone -->
      <div class="relative bg-surface border border-border rounded-[2rem] p-2 shadow-2xl w-28 sm:w-36 transition-transform hover:scale-105 duration-300">
        <div class="bg-bg rounded-[1.5rem] h-64 sm:h-72 overflow-hidden">
          <div class="bg-accent/10 h-8 flex items-center px-3">
            <div class="w-16 h-2 rounded bg-text-dim/30"></div>
          </div>
          <div class="p-3 space-y-2">
            <div class="w-full h-4 rounded bg-text-dim/10"></div>
            <div class="w-3/4 h-4 rounded bg-text-dim/10"></div>
            <div class="w-1/2 h-4 rounded bg-text-dim/10"></div>
            <div class="w-full h-16 rounded bg-text-dim/5 mt-4"></div>
            <div class="w-5/6 h-4 rounded bg-text-dim/10"></div>
            <div class="w-2/3 h-4 rounded bg-text-dim/10"></div>
          </div>
        </div>
        <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-8 h-1 bg-text-dim/40 rounded-full"></div>
      </div>
      <!-- Tablet -->
      <div class="relative bg-surface border border-border rounded-[1.5rem] p-2 shadow-2xl w-44 sm:w-56 transition-transform hover:scale-105 duration-300">
        <div class="bg-bg rounded-[1.25rem] h-72 sm:h-80 overflow-hidden">
          <div class="bg-accent/10 h-10 flex items-center px-4">
            <div class="w-24 h-2.5 rounded bg-text-dim/30"></div>
          </div>
          <div class="p-4 space-y-2">
            <div class="w-full h-5 rounded bg-text-dim/10"></div>
            <div class="w-5/6 h-5 rounded bg-text-dim/10"></div>
            <div class="w-3/4 h-5 rounded bg-text-dim/10"></div>
            <div class="w-full h-20 rounded bg-text-dim/5 mt-4"></div>
            <div class="w-11/12 h-5 rounded bg-text-dim/10"></div>
            <div class="w-4/5 h-5 rounded bg-text-dim/10"></div>
            <div class="w-3/5 h-5 rounded bg-text-dim/10"></div>
          </div>
        </div>
      </div>
      <!-- Desktop -->
      <div class="relative bg-surface border border-border rounded-xl p-2 shadow-2xl w-56 sm:w-72 transition-transform hover:scale-105 duration-300">
        <div class="bg-bg rounded-lg h-72 sm:h-80 overflow-hidden">
          <div class="bg-accent/10 h-8 flex items-center px-4 gap-2">
            <div class="w-3 h-3 rounded-full bg-danger/50"></div>
            <div class="w-3 h-3 rounded-full bg-warning/50"></div>
            <div class="w-3 h-3 rounded-full bg-success/50"></div>
            <div class="w-32 h-2.5 rounded bg-text-dim/20 ml-4"></div>
          </div>
          <div class="p-4 space-y-2">
            <div class="flex gap-4">
              <div class="w-1/3 space-y-2">
                <div class="w-full h-20 rounded bg-text-dim/5"></div>
                <div class="w-full h-4 rounded bg-text-dim/10"></div>
              </div>
              <div class="w-2/3 space-y-2">
                <div class="w-full h-5 rounded bg-text-dim/10"></div>
                <div class="w-5/6 h-5 rounded bg-text-dim/10"></div>
                <div class="w-3/4 h-5 rounded bg-text-dim/10"></div>
              </div>
            </div>
            <div class="w-full h-4 rounded bg-text-dim/10 mt-4"></div>
            <div class="w-11/12 h-4 rounded bg-text-dim/10"></div>
          </div>
        </div>
        <div class="mt-2 mx-auto w-3/5 h-2 bg-text-dim/20 rounded"></div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-surface border-t border-border">
    <div class="max-w-7xl mx-auto px-6 py-20 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-text">Everything you need</h2>
      <p class="mt-4 text-text-muted">No account required. No limits. Completely free.</p>
      <div class="mt-14 grid sm:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl bg-bg border border-border text-left hover:border-accent/30 transition-colors group">
          <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-5 group-hover:bg-accent/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
              <rect width="14" height="20" x="5" y="2" rx="2" ry="2" /><path d="M12 18h.01" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text mb-2">100+ Devices</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Test on iPhones, Samsungs, Pixels, iPads, and more. Every device you need, ready to go.
          </p>
        </div>
        <div class="p-8 rounded-2xl bg-bg border border-border text-left hover:border-accent/30 transition-colors group">
          <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-5 group-hover:bg-accent/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
              <rect width="7" height="18" x="3" y="3" rx="1" /><rect width="7" height="18" x="14" y="3" rx="1" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text mb-2">Multi-View</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Compare mobile, tablet, and desktop views side-by-side. See how your site adapts.
          </p>
        </div>
        <div class="p-8 rounded-2xl bg-bg border border-border text-left hover:border-accent/30 transition-colors group">
          <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-5 group-hover:bg-accent/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text mb-2">Share Links</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Bookmark and share your exact test configurations. Collaborate with your team effortlessly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Donate -->
  <section class="border-t border-border">
    <div class="max-w-7xl mx-auto px-6 py-20 text-center">
      <h2 class="text-3xl font-bold text-text">Support ViewPort</h2>
      <p class="mt-4 text-text-muted max-w-lg mx-auto">
        100% free and open-source. If this tool helps you, consider supporting development.
      </p>
      <a
        href="#"
        class="mt-8 inline-flex items-center gap-2 px-8 py-4 text-lg font-semibold text-white bg-danger rounded-xl hover:bg-red-500 transition-colors shadow-lg shadow-danger/20"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
        </svg>
        Donate Now
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-border bg-surface">
    <div class="max-w-7xl mx-auto px-6 py-12">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-2">
          <span class="text-lg font-bold text-accent">ViewPort</span>
          <span class="text-sm text-text-dim">Built with ♥ for developers</span>
        </div>
        <div class="flex items-center gap-6">
          <a href="/" class="text-sm text-text-muted hover:text-text transition-colors">Home</a>
          <a href="/app" class="text-sm text-text-muted hover:text-text transition-colors">App</a>
          <a href="#" class="text-sm text-text-muted hover:text-text transition-colors">GitHub</a>
          <a href="#" class="text-sm text-text-muted hover:text-text transition-colors">Twitter</a>
        </div>
      </div>
      <div class="mt-8 pt-6 border-t border-border text-center">
        <p class="text-xs text-text-dim">© 2024 ViewPort. Free for everyone.</p>
      </div>
    </div>
  </footer>
</BaseLayout>
